{
  "name": "conform-cf-worker",
  "version": "0.1.0",
  "description": "Open-source Cloudflare Worker for private form-to-email delivery",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && wrangler deploy --dry-run",
    "hash-email": "node scripts/hash-email.mjs"
  },
  "keywords": [
    "cloudflare-workers",
    "email",
    "forms",
    "privacy"
  ],
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^4.20260113.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.7",
    "wrangler": "^4.43.0"
  }
}
